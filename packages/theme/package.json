{
  "name": "@nordaun/theme",
  "version": "1.0.0",
  "description": "A simple theme provider and context for your React apps.",
  "homepage": "https://ui.nordaun.com/packages/theme",
  "author": "vorhdam <https://github.com/vorhdam>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nordaun/ui.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.tsx"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "package:build": "tsup ./src/index.tsx --format cjs,esm --dts",
    "package:dev": "tsup ./src/index.tsx --format cjs,esm --dts --watch"
  },
  "devDependencies": {
    "@repo/eslint": "*",
    "@repo/typescript": "*",
    "@types/node": "^20",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.2.14",
    "js-cookie": "^3.0.5",
    "react": "^19.2.6"
  }
}
